[Unit]
Description=itzephir.com Ktor website (%i)
After=network.target
ConditionPathExists=/srv/itzephir/%i/current/lib/website.jar

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/itzephir/%i/current
EnvironmentFile=/etc/itzephir/%i.env
ExecStart=/usr/bin/java -Xms32m -Xmx192m -cp /srv/itzephir/%i/current/lib/* com.itzephir.website.ApplicationKt
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
